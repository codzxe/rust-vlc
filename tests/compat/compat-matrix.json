  {
   "id": "web-wasm",
   "kind": {
    "type": "steps",
    "steps": [
     {
      "purpose": "the wasm32 engine-core module builds for real (probe -> demux -> engine; codecs edge target-gated off \u2014 apps/web/Cargo.toml)",
      "argv": [
       "cargo",
       "build",
       "-p",
       "lumen-web",
       "--target",
       "wasm32-unknown-unknown"
      ],
      "cwd": ".",
      "artifacts": [],
      "timeout_s": 2400
     },
     {
      "purpose": "the web crate's host-side lane proof: capability snapshot + first-vertical MJPEG/PCM decode with the real decoders linked natively (the wasm module reports the decoder split honestly)",
      "argv": [
       "cargo",
       "test",
       "-p",
       "lumen-web"
      ],
      "cwd": ".",
      "artifacts": [],
      "timeout_s": 2400
     }
    ]
   },
   "label": "Web/wasm (recorded build + lane-proof steps; the wasm module ships decoder-less)"
  },
