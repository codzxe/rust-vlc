<?xml version="1.0" encoding="utf-8"?>
<!-- Hand-authored for card 6.C1a (ISO/IEC 23009-1 shapes the ffmpeg
     muxer does not emit): a shared duration-based SegmentTemplate at the
     AdaptationSet level, ContentProtection with cenc:default_KID,
     multi-level BaseURL, xml:lang, a Role descriptor and a SegmentBase
     single-URL subtitle representation. Not generated by any tool. -->
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011"
     xmlns:cenc="urn:mpeg:cenc:2013"
     profiles="urn:mpeg:dash:profile:isoff-on-demand:2011"
     type="static"
     mediaPresentationDuration="PT2M0.0S"
     minBufferTime="PT2.0S">
  <BaseURL>https://cdn.example/vod/</BaseURL>
  <Period id="p0" start="PT0S" duration="PT2M">
    <BaseURL>p0/</BaseURL>
    <AdaptationSet mimeType="video/mp4" codecs="avc1.640028" xml:lang="en"
                   segmentAlignment="true" startWithSAP="1">
      <ContentProtection schemeIdUri="urn:mpeg:dash:mp4protection:2011" value="cenc"
                         cenc:default_KID="11223344-5566-7788-99aa-bbccddeeff00"/>
      <SegmentTemplate timescale="900000" duration="4500000" startNumber="1"
                       initialization="$RepresentationID$/init.mp4"
                       media="$RepresentationID$/seg-$Number$.m4s"/>
      <Representation id="v-1080" bandwidth="4800000" width="1920" height="1080">
        <BaseURL>hi/</BaseURL>
      </Representation>
      <Representation id="v-720" bandwidth="2400000" width="1280" height="720"/>
      <Representation id="v-360" bandwidth="800000" width="640" height="360"/>
    </AdaptationSet>
    <AdaptationSet contentType="text" xml:lang="en">
      <Role schemeIdUri="urn:mpeg:dash:role:2011" value="subtitle"/>
      <Representation id="cc-en" bandwidth="1000" mimeType="text/vtt">
        <SegmentBase timescale="1000" indexRange="500-1200" indexRangeExact="true">
          <Initialization range="0-499"/>
        </SegmentBase>
      </Representation>
    </AdaptationSet>
  </Period>
</MPD>
