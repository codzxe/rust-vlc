# .env.example — reference for the machine-local .env file.
# .env is gitignored machine-local config; copy this file to .env and adjust.
# Every variable used by the repo is documented below with a safe placeholder.

# SQLite database location for Prisma (machine-local absolute path in real .env).
# Placeholder below is a safe relative path; .env typically uses an absolute file: URL.
DATABASE_URL=file:./db/custom.db
