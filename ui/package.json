{
  "name": "lumen-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lumen player UI — React + TypeScript (doc 08 §8 scaffold, card 4.A1)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "lint:css": "npx -p stylelint@18.0.0 -p stylelint-config-standard@41.0.0 stylelint 'src/**/*.css'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "webmatrix": "node scripts/web-matrix-run.mjs",
    "visual": "node scripts/visual-run.mjs",
    "visual:pr": "node scripts/visual-run.mjs --mode=pr",
    "visual:nightly": "node scripts/visual-run.mjs --mode=nightly",
    "visual:update": "node scripts/visual-run.mjs --update",
    "visual:seed": "node scripts/visual-run.mjs --mode=pr --seed",
    "tokens:generate": "node scripts/gen-tokens.mjs",
    "tokens:check": "node scripts/gen-tokens.mjs --check",
    "settings:generate": "node scripts/gen-settings-screens.mjs",
    "settings:check": "node scripts/gen-settings-screens.mjs --check",
    "hotkeys:generate": "node scripts/gen-hotkeys-data.mjs",
    "hotkeys:check": "node scripts/gen-hotkeys-data.mjs --check",
    "l10n:check": "node scripts/l10n-check.mjs",
    "l10n:pseudo-probe": "node scripts/l10n-pseudo-probe.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "30.1.3",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
